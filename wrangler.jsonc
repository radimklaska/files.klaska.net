{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "files-klaska-net",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "files-klaska-net" }
  ],
  "routes": [{ "pattern": "files.klaska.net", "custom_domain": true }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
